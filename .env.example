# ---------- Angebotsquelle ----------
# "demo" = gekennzeichnete Testdaten. Jeder andere Wert meldet "nicht eingerichtet", bis die echte Anbindung programmiert ist.
OFFER_PROVIDER="demo"
# OFFER_PROVIDER_NAME="Name der zentralen Angebotsplattform"

# ---------- Administrator ----------
# Hash erzeugen:  npm run admin:hash -- "langes sicheres Passwort"
ADMIN_PASSWORD_HASH=""
# Nur lokal (wird im Produktivbetrieb ignoriert):
# ADMIN_PASSWORD="lokales-testpasswort"
# Zwei-Faktor-Anmeldung (empfohlen):  npm run admin:2fa
ADMIN_TOTP_SECRET=""
ADMIN_EMAIL="admin@daryos.de"
ADMIN_NAME="Daryos Inhaber"

# ---------- KI (Gemini, nur serverseitig) ----------
# Leer lassen = regelbasierte Prüfung ohne KI. AI Studio setzt den Schlüssel über das Secrets-Panel.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ---------- E-Mail-Benachrichtigung an den Administrator ----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
ADMIN_NOTIFY_EMAIL=""

# ---------- WhatsApp ----------
# Nummer für den Chat-Link (wa.me) auf der Webseite
WHATSAPP_NUMBER=""
# WhatsApp-Bot über die offizielle WhatsApp Business Platform (Cloud API von Meta).
# Alle vier Werte aus der Meta-App (developers.facebook.com → WhatsApp → API-Setup):
WHATSAPP_ACCESS_TOKEN=""      # dauerhaftes System-User-Token, NIE im Browser verwenden
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""        # zur Prüfung der Webhook-Signatur (X-Hub-Signature-256)
WHATSAPP_VERIFY_TOKEN=""      # frei gewählter, langer Zufallswert; identisch in Meta eintragen
WHATSAPP_GRAPH_VERSION="v21.0"
WHATSAPP_AUTO_REPLY="true"    # false = nur Postfach, keine automatischen Antworten
# Webhook-URL in Meta: https://IHRE-DOMAIN/api/whatsapp/webhook  (Feld "messages" abonnieren)

# ---------- Betrieb ----------
# Öffentliche URL (Links in Benachrichtigungen). AI Studio/Cloud Run setzt sie automatisch.
APP_URL=""
PORT="3000"
# Hinter Cloud Run / Proxy: "true", damit Rate-Limits die echte Client-IP verwenden
TRUST_PROXY=""
DATA_FILE="data/requests.json"
WHATSAPP_DATA_FILE="data/whatsapp.json"
ACCOUNTING_DATA_FILE="data/buchhaltung.json"
RETENTION_DAYS_COMPARISON="30"
RETENTION_DAYS_CONTACT="180"
