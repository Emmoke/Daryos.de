# ---------- Angebotsquelle ----------
# "demo" = gekennzeichnete Testdaten. Jeder andere Wert meldet "nicht eingerichtet", bis die echte Anbindung programmiert ist.
OFFER_PROVIDER="demo"
# OFFER_PROVIDER_NAME="Name der zentralen Angebotsplattform"

# ---------- Administrator ----------
# Hash erzeugen:  npm run admin:hash -- "langes sicheres Passwort"
ADMIN_PASSWORD_HASH=""
# Nur lokal (wird im Produktivbetrieb ignoriert):
# ADMIN_PASSWORD="lokales-testpasswort"
ADMIN_EMAIL="admin@daryos.de"
ADMIN_NAME="Daryos Inhaber"

# ---------- KI (Gemini, nur serverseitig) ----------
# Leer lassen = regelbasierte Prüfung ohne KI. AI Studio setzt den Schlüssel über das Secrets-Panel.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ---------- E-Mail-Benachrichtigung an den Administrator ----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
ADMIN_NOTIFY_EMAIL=""

# ---------- WhatsApp (Chat-Link, keine automatisierte Business-API) ----------
WHATSAPP_NUMBER=""

# ---------- Betrieb ----------
# Öffentliche URL (Links in Benachrichtigungen). AI Studio/Cloud Run setzt sie automatisch.
APP_URL=""
PORT="3000"
# Hinter Cloud Run / Proxy: "true", damit Rate-Limits die echte Client-IP verwenden
TRUST_PROXY=""
DATA_FILE="data/requests.json"
RETENTION_DAYS_COMPARISON="30"
RETENTION_DAYS_CONTACT="180"
